# Copier en .env et renseigner les valeurs.
# Generer la cle : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Attention : pas de $ dans les valeurs, Docker Compose interprete $nom
#             comme une variable dans les fichiers d'environnement.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Mot de passe PostgreSQL des conteneurs. Lu par docker-compose.yml.
POSTGRES_PASSWORD=inforest

# Laisser vide hors Docker : SQLite est alors utilise.
# DATABASE_URL=postgres://inforest:inforest@db:5432/inforest

# Courriel. Dans les conteneurs, le compose pointe deja sur MailDev.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InForet <noreply@localhost>
SITE_URL=http://127.0.0.1:8000

# Celery. Hors Docker, remplacer redis par localhost.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0